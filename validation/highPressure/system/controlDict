Description
    controlDict. The solver entry selects the moldingFoam solver module and
    the libs entry loads it; both are part of the moldingFoam case
    contract.
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          moldingFoam;

libs            ("libmoldingFoam.so");

startFrom       startTime;

startTime       0;

stopAt          endTime;

// The acceptance window ends just after the gate seal: once the gate
// is sealed the cooling melt would shrink and cavitate, which the current
// Tait thermodynamics cannot represent (no void model) - see task 018a
endTime         1.6;

deltaT          1e-05;

writeControl    adjustableRunTime;

writeInterval   0.1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  7;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  on;

maxCo           0.5;

maxAlphaCo      0.03;

// The packing-window melt mass conservation error is a temporal
// truncation of the compressible coupling (measured order dt^1.6): with
// an unbounded step the near-static packing runs at dt ~6.5e-4 and the
// window error reaches ~4.5e-2. Capping the step at 1e-4 restores it to
// ~2.6e-4 (task 018/031) at a comparable runtime
maxDeltaT       1e-4;

functions
{
    inletMassFlow
    {
        // Polymer mass flow rate through the gate [kg/s]; the boundary
        // values of alphaRhoPhi.melt are face mass fluxes
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        writeFields     no;
        log             yes;
        patch           inlet;
        operation       sum;
        fields          (alphaRhoPhi.melt);
    }

    ventMassFlow
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        writeFields     no;
        log             yes;
        patch           vent;
        operation       sum;
        fields          (alphaRhoPhi.melt);
    }

    alphaMeltRho
    {
        // Polymer mass concentration field alpha.melt*rho.melt [kg/m^3]
        type            multiply;
        libs            ("libfieldFunctionObjects.so");
        writeControl    writeTime;
        writeFields     no;
        fields          (alpha.melt rho.melt);
        result          alphaMeltRho;
    }

    polymerMass
    {
        // Polymer mass in the cavity [kg]
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        writeFields     no;
        log             yes;
        cellZone        all;
        operation       volIntegrate;
        fields          (alphaMeltRho);
    }
}

