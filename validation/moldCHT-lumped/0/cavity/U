FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0/cavity";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    cavityBottom
    {
        type            noSlip;
    }

    cavitySides
    {
        type            noSlip;
    }

    cavity_to_mold
    {
        type            noSlip;
    }

    defaultFaces
    {
        type            empty;
    }
}

