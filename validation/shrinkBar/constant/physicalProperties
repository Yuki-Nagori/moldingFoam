FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

rho
{
    type        uniform;
    value       7854;
}

nu
{
    type        uniform;
    value       0.0;
}

E
{
    type        uniform;
    value       2e+11;
}

Cv
{
    type        uniform;
    value       434;
}

kappa
{
    // Frozen temperature field: the mapped shrinkage eigenstrain is
    // imposed through the initial T profile with no conduction (task 013b)
    type        uniform;
    value       1e-30;
}

alphav
{
    // Unit expansion: T equals the free linear shrinkage (Tref = 0 in
    // solidDisplacement), so sigma = sigmaD - I*threeKalpha*eps
    type        uniform;
    value       1.0;
}

planeStress     yes;
thermalStress   yes;

