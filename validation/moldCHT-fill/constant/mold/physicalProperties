Description
    Mould (solid) region thermo: steel-like constant properties.
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant/mold";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType          constSolidThermo;

rho
{
    type        uniform;
    value       7800;   // [kg/m^3]
}

Cv
{
    type        uniform;
    value       500;    // [J/kg/K]
}

kappa
{
    type        uniform;
    value       50;     // [W/m/K]
}

