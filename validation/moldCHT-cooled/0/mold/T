Description
    Mould temperature: initially 353 K; the bottom face is the conjugate
    interface and every outer face is adiabatic, so the whole domain
    is closed except the inlet and vent (global energy check).
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/mold";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 353;

boundaryField
{
    moldSides
    {
        type            zeroGradient;
    }

    moldTop
    {
        type               moldingConvectiveCooling;
        kappa              50;      // [W/m/K] mould conductivity
        htc                2000;    // [W/m^2/K] coolant HTC
        coolantTemperature 300;     // [K]
        refValue           uniform 300;
        refGradient        uniform 0;
        valueFraction      uniform 0;
        value              uniform 353;
    }

    mold_to_cavity
    {
        type            coupledTemperature;
        Tnbr            T;
        value           $internalField;
    }

    defaultFaces
    {
        type            empty;
    }
}

// ************************************************************************* //
