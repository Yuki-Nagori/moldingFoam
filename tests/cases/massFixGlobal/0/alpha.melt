FoamFile
{
    format      ascii;
    class       volScalarField;
    object      alpha.melt;
}
dimensions      [];
internalField   uniform 1;
boundaryField
{
    inlet   { type fixedValue; value uniform 1; }
    vent    { type inletOutlet; inletValue uniform 0; value uniform 0; }
    walls   { type zeroGradient; }
    ".*"    { type zeroGradient; }
}
