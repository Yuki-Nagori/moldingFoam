Description
    Mixture momentum transport: laminar generalised Newtonian with the
    CrossWlf model (HDPE-like grade) registered by libmoldingFoam.so.
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      momentumTransport;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  laminar;

laminar
{
    model           generalisedNewtonian;

    viscosityModel  CrossWlf;

    CrossWlfCoeffs
    {
        n           0.393539;   // [-]
        tauStar     64568.9;    // [Pa]
        D1          3.76174e15; // [Pa s]
        D2          153.15;     // [K]
        D3          0;          // [K/Pa]
        A1          33.21;      // [-]
        A2          51.6;       // [K]
        etaMin      5;          // [Pa s]
        etaMax      1e6;

        // Crystallinity-viscosity coupling (task 043, gap G5): eta is
        // multiplied by (1 - chi/chiInfinity)^(-exponent); the branch was never
        // exercised by any case before
        crystallinity
        {
            chiInfinity 1;
            exponent    2;
        }        // [Pa s]
        gammaDotMin 1e-06;      // [1/s]
    }
}

