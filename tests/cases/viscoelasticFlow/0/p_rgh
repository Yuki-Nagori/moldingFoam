Description
    Static pressure minus hydrostatic; the sealed domain is closed, so
    all walls are zero-flux (fixedFluxPressure).
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    bottom
    {
        type            moldingPrghPressure;
        refValue        uniform 1e5;
        refGradient     uniform 0;
        valueFraction   uniform 0;
        value           uniform 1e5;
    }

    top
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    left
    {
        type            cyclic;
    }

    right
    {
        type            cyclic;
    }
}

