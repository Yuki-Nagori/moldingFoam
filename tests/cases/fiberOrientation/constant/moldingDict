Description
    Couette shear-heating validation: the process groups are present only
    because moldingFoam requires them. The packing group never drives a
    boundary here (there are no molding inlet/vent patches); the ejection
    temperature is set below any reachable value so the run stops at
    endTime. The viscous-dissipation source is enabled explicitly.
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      moldingDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

injection
{
    meltTemperature  480;
}

packing
{
    switchFraction   1;
    switchPressure   1e9;

    pressure
    {
        type            constant;
        value           1e5;
    }
}

cooling
{
    ejectionTemperature  50;
    releasePressure      1e5;
}

viscousDissipation  false;

// Folgar-Tucker fibre orientation: the quadratic closure is exact for a
// single fibre and reproduces the Jeffery orbit
fiberOrientation
{
    aspectRatio            20;      // [-]
    interactionCoefficient 0.01;    // [-]
    closure                quadratic;
}

// Fibre-coupled anisotropic shrinkage (task 034): the shrinkage tensor
// trace is the volumetric shrinkage and the aligned direction shrinks
// less (orientationShrinkage = beta)
shrinkage
{
    referenceDensity         950;
    referenceTemperature     293.15;
    elasticModulus           2e9;
    poissonRatio             0.3;
    thermalExpansion         7e-5;
    orientationShrinkage      0.5;
}

// Two cycles; the ejection criterion triggers on the first check
nCycles 1;

// Gate freezes once its mass-weighted melt temperature drops to this
// value; the cycleReset base starts at 480 K so the seal triggers at the
// first packing step
gateFreezeTemperature 485;

