Description
    Mould temperature: initially 353 K; the bottom face is the conjugate
    interface to the cavity, the top face is held at the cooling water
    temperature and the sides are adiabatic.
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/mold";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 353;

boundaryField
{
    moldSides
    {
        type            zeroGradient;
    }

    moldTop
    {
        type            fixedValue;
        value           uniform 400;
    }

    mold_to_water
    {
        type            coupledTemperature;
        Tnbr            T;
        value           $internalField;
    }

    defaultFaces
    {
        type            empty;
    }
}

