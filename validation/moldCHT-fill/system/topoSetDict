Description
    Cell zones for the two fill regions: the cavity box and the mould box
    are non-overlapping and splitMeshRegions turns them into meshes.
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    {
        name    cavity;
        type    cellZoneSet;
        action  new;
        source  boxToCell;
        box     (0 -0.001 -0.001) (0.06 0.002 0.003);
    }

    {
        name    mold;
        type    cellZoneSet;
        action  new;
        source  boxToCell;
        box     (0 0.002 -0.001) (0.06 0.007 0.003);
    }
);

