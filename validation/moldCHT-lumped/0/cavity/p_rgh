Description
    Static pressure minus hydrostatic; the sealed cavity is closed.
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/cavity";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
    cavityBottom
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    cavitySides
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    cavity_to_mold
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    defaultFaces
    {
        type            empty;
    }
}

