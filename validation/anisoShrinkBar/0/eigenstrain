FoamFile
{
    format      ascii;
    class       volSymmTensorField;
    location    "0";
    object      eigenstrain;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform (0.02 0 0 0.005 0 0);

boundaryField
{
    topSurface
    {
        type            calculated;
        value           uniform (0.02 0 0 0.005 0 0);
    }
    bottomSurface
    {
        type            calculated;
        value           uniform (0.02 0 0 0.005 0 0);
    }
    fixedEnd
    {
        type            calculated;
        value           uniform (0.02 0 0 0.005 0 0);
    }
    tractionEnd
    {
        type            calculated;
        value           uniform (0.02 0 0 0.005 0 0);
    }
    defaultFaces
    {
        type            empty;
    }
}

