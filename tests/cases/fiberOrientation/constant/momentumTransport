Description
    Mixture momentum transport: laminar generalised Newtonian with the
    CrossWlf model (HDPE-like grade) registered by libmoldingFoam.so.
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      momentumTransport;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  laminar;

laminar
{
    model           generalisedNewtonian;

    viscosityModel  CrossWlf;

    CrossWlfCoeffs
    {
        n           0.393539;   // [-]
        tauStar     64568.9;

    // Lipscomb orientation correction (task 034): the apparent
    // viscosity follows the alignment of the strain rate with the fibres
    lipscombRatio  3;            // [-]
        D1          3.76174e15; // [Pa s]
        D2          153.15;     // [K]
        D3          0;          // [K/Pa]
        A1          33.21;      // [-]
        A2          51.6;       // [K]
        etaMin      5;          // [Pa s]
        etaMax      1e6;        // [Pa s]
        gammaDotMin 1e-06;      // [1/s]
    }
}

// ************************************************************************* //
