Description
    Cavity velocity: melt enters through the inlet at a fixed volumetric
    flow rate and the vent passes the displaced air and then the melt.
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0/cavity";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type                moldingInletVelocity;
        volumetricFlowRate  3e-07;
        value               uniform (0 0 0);
    }

    vent
    {
        type            moldingVentVelocity;
        value           uniform (0 0 0);
    }

    cavityBottom
    {
        type            noSlip;
    }

    cavity_to_mold
    {
        type            noSlip;
    }

    defaultFaces
    {
        type            empty;
    }
}

// ************************************************************************* //
