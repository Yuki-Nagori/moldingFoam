Description
    controlDict for the Stefan benchmark: 100 s of physical time at a fixed
    0.02 s step (implicit conduction), fields written every 20 s for the
    freeze-front comparison.
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          moldingFoam;

libs            ("libmoldingFoam.so");

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         100;

deltaT          0.02;

writeControl    adjustableRunTime;

writeInterval   20;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable no;

adjustTimeStep  off;

functions
{
    // Volume-weighted mean temperature: the slab starts from the steady
    // linear profile plus a half-sine mode, so the mean carries the mode's
    // amplitude (mean = 2 A / pi) and its decay rate measures the
    // conductivity along the gradient (verify-aniso-conduction.py)
    meanTemperature
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        writeFields     no;
        log             yes;
        cellZone        all;
        operation       volAverage;
        fields          (T);
    }
}

