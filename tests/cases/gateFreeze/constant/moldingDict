Description
    Gate-freeze feature case: the gate temperature reaches
    gateFreezeTemperature and the gate must seal; the run continues to
    endTime so the closed cavity (constant melt mass) can be checked
    (tasks 010/044).
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      moldingDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

injection
{
    meltTemperature  480;
}

packing
{
    switchFraction   1;
    switchPressure   1e9;

    // Smooth gate seal (task 018): the gate flux ramps to zero over this
    // duration after the freeze time instead of sealing instantaneously
    // (task 043: the non-zero ramp branch was never exercised before)
    gateSealRamp     0.01;

    // Explicit packing-pressure ramp (task 044: only the adaptive default
    // was ever exercised; the explicit branch and its startup echo were
    // never covered)
    pressureRamp     0.2;

    pressure
    {
        type            constant;
        value           1e5;
    }
}

cooling
{
    ejectionTemperature  300;   // unreachable: the run must reach endTime so the closed-cavity window is sampled (task 044)
    releasePressure      1e5;
}

viscousDissipation  false;

// Two cycles; the ejection criterion triggers on the first check
nCycles 1;

// Gate freezes once its mass-weighted melt temperature drops to this
// value; the cycleReset base starts at 480 K so the seal triggers at the
// first packing step
gateFreezeTemperature 485;

// ************************************************************************* //
