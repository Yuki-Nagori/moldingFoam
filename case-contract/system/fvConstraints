Description
    fvConstraints for the contract case. limitTemperature bounds the
    solved temperature while cells cross the Tait solidification band,
    where the apparent Cv of the blend is negative; the moldingFoam
    energy predictor adds the matching latent-heat capacity to the
    matrix diagonal (see README section 6).
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvConstraints;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

limitT
{
    type            limitTemperature;
    cellZone        all;
    field           T;
    phase           melt;
    min             250;
    max             3000;
}

